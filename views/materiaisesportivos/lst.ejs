<%- include('../cabecalho', { titulo: 'Lista de Materiais esportivos' }) %>
    <section class="container">
        <div class="section-heading">
            <h2>Materiais esportivos cadastrados</h2>
            <a class="button" href="/materiais/add">Adicionar</a>
            <form action="/materiais/lst" method="POST">
                <input type="text" name="pesquisar" placeholder="Pesquisar material">

                <button type="submit">Pesquisar</button>
            </form>
        </div>
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Preço (R$)</th>
                        <th>Categoria</th>
                        <th>Foto</th>
                        <th>Ações</th>

                    </tr>
                </thead>
                <tbody>
                    <% if (materiais && materiais.length> 0) { %>
                        <% materiais.forEach(item=> { %>
                            <tr>
                                <td>
                                    <%= item.nome %>
                                </td>
                                <td>R$ <%= Number(item.preco).toFixed(2).replace(".", "," ) %>
                                </td>
                                <td>
                                    <%= item.categoria %>
                                </td>
                                <td><img src="<%=item.foto%>" width="150" height="150"></td>

                                <td class="actions">
                                    <a href="/materiais/upd/<%= item._id %>">Editar</a>
                                    <form action="/materiais/del/<%= item._id %>" method="POST"
                                        onsubmit="return confirm('Deseja realmente excluir este registro?')">
                                        <button class="danger" type="submit">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4">Nenhum registro cadastrado.</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </section>
    <%- include('../rodape') %>