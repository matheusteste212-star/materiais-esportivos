<%- include('../cabecalho', { titulo: 'Editar Academia' }) %>
<section class="container">
    <h2>Editar registro</h2>
    <form action="/academias/upd/<%= item._id %>" method="POST">
        <label for="nome">Nome:</label>
        <input id="nome" type="text" name="nome" value="<%= item.nome %>" required>
        <label for="cidade">Cidade:</label>
        <input id="cidade" type="text" name="cidade" value="<%= item.cidade %>" required>
        <label for="tipoesporte">Tipo de esporte:</label>
        <input id="tipoesporte" type="text" name="tipoesporte" value="<%= item.tipoesporte %>" required>
        <div class="form-actions">
            <button type="submit">Salvar alterações</button>
            <a class="button secondary" href="/academias">Cancelar</a>
        </div>
    </form>
</section>
<%- include('../rodape') %>
